NODE_ENV=production
PORT=3000
TRUST_PROXY=1
CORS_ORIGIN=https://www.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
EMAIL_TO=contact@example.com
RATE_LIMIT_MAX=50
BODY_LIMIT_KB=10
LOG_LEVEL=info
COMPANY_LOGO_URL=
BRAND_COLOR=#ffffff
COMPANY_NAME=El Waab